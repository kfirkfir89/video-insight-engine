# ================================================
# Video Insight Engine - Environment Configuration
# ================================================
# Copy this file to .env and fill in your values
# ================================================
CLAUDE_PROJECT_DIR="/path/to/your/video-insight-engine"

# ------------------------------------------------
# General
# ------------------------------------------------
NODE_ENV=development
# Log level: debug, info, warning, error (debug is very verbose)
LOG_LEVEL=info

# ------------------------------------------------
# MongoDB
# ------------------------------------------------
# Development (no auth)
MONGODB_URI=mongodb://localhost:27017/video-insight-engine

# Production (with auth)
# MONGO_ROOT_USER=admin
# MONGO_ROOT_PASS=change-this-password

# ------------------------------------------------
# Authentication (JWT)
# ------------------------------------------------
# IMPORTANT: Generate secure secrets for production!
# Use: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------
# API Service (vie-api)
# ------------------------------------------------
PORT=3000

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Video creation daily limit (0 = unlimited, useful for dev/admin)
VIDEO_DAILY_LIMIT=10

# Per-user daily LLM cost cap, in USD (0 disables the limit, -1 = unlimited)
# Enforced in POST /api/videos via CostMonitorService.reserveUserCost
USER_COST_LIMIT_FREE=2
USER_COST_LIMIT_PRO=20
USER_COST_LIMIT_TEAM=-1

# Global aggregate cost ceiling (USD/day) — separate from the per-user cap above
COST_DAILY_LIMIT=50

# ------------------------------------------------
# Frontend & CORS
# ------------------------------------------------
FRONTEND_URL=http://localhost:5173

# Additional CORS origins (comma-separated, optional)
# Used for SSE endpoints that bypass Fastify's CORS plugin
# CORS_ADDITIONAL_ORIGINS=https://staging.yourdomain.com,https://preview.yourdomain.com

# Vite environment variables
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000/ws

# Debug WebSocket events (development only)
# VITE_DEBUG_WS=true

# Production (update with your domain)
# VITE_API_URL=https://api.yourdomain.com/api
# VITE_WS_URL=wss://api.yourdomain.com/ws

# ------------------------------------------------
# Internal Service Communication
# ------------------------------------------------
# IMPORTANT: Generate a secure secret for production!
# Use: openssl rand -base64 32
INTERNAL_SECRET=your-internal-secret-generate-with-openssl-rand

# ------------------------------------------------
# Internal Service URLs
# ------------------------------------------------
SUMMARIZER_URL=http://localhost:8000

# ------------------------------------------------
# RabbitMQ — pipeline job queue (vie-rabbitmq)
# ------------------------------------------------
# Management UI: http://localhost:15672 (creds = RABBITMQ_DEFAULT_USER / PASS)
RABBITMQ_DEFAULT_USER=vie
RABBITMQ_DEFAULT_PASS=vie-dev
RABBITMQ_URL=amqp://vie:vie-dev@vie-rabbitmq:5672/

# Toggle queue-based pipeline. When false, the API calls the summarizer over HTTP
# (legacy path); when true, video creation publishes a job to RabbitMQ and the
# vie-summarizer-worker consumes it. Flip on a per-environment basis during rollout.
USE_QUEUE_PIPELINE=false

# Worker tuning — concurrent jobs per worker process and total retries before DLQ.
WORKER_CONCURRENCY=2
WORKER_MAX_RETRIES=3

# Admin key used by GET /api/admin/queue/* endpoints (separate from JWT auth).
ADMIN_API_KEY=dev-admin-key-change-me

# ------------------------------------------------
# Summarizer Service (vie-summarizer)
# ------------------------------------------------
SUMMARIZER_PORT=8000

# ------------------------------------------------
# Assistant Service (vie-assistant)
# ------------------------------------------------
ASSISTANT_PORT=8001
# ASSISTANT_URL=http://localhost:8001
# MAX_CONTEXT_CHUNKS=8
# MAX_CONVERSATION_TURNS=20

# ------------------------------------------------
# LLM Provider Configuration (Multi-Provider)
# ------------------------------------------------
# Provider options: anthropic, openai, gemini
LLM_PROVIDER=anthropic
LLM_FAST_PROVIDER=openai
LLM_FALLBACK_PROVIDER=gemini

# Token limits
LLM_MAX_TOKENS=4096
LLM_FAST_MAX_TOKENS=2048

# Timeouts and retries
LLM_TIMEOUT_SECONDS=60.0
LLM_NUM_RETRIES=2

# Optional model overrides (uses provider defaults if not set)
# LLM_MODEL=anthropic/claude-sonnet-4-6
# LLM_FAST_MODEL=openai/gpt-4o-mini

# ------------------------------------------------
# Provider API Keys
# ------------------------------------------------
# Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI (https://platform.openai.com/)
OPENAI_API_KEY=your-openai-api-key-here

# Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here

# ------------------------------------------------
# YouTube Transcript Proxy (Webshare)
# ------------------------------------------------
# Get credentials from: https://www.webshare.io/
# Purchase "Residential" proxy package (NOT "Proxy Server" or "Static Residential")
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=

# ------------------------------------------------
# S3 — uses existing vie-transcripts bucket for all media (frames, transcripts, audio)
# ------------------------------------------------
S3_BUCKET=vie-transcripts
S3_PRESIGNED_URL_EXPIRY=3600

# AWS S3
# Free tier: 5GB storage, 20K GET, 2K PUT requests/month
# Create bucket at: https://s3.console.aws.amazon.com/
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Frame extraction (extract actual video frames for visual blocks)
FRAME_EXTRACTION_ENABLED=true

# Optional: Use LocalStack for offline S3 development
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# ------------------------------------------------
# Future Services (not used in MVP)
# ------------------------------------------------

# Meilisearch (for full-text search)
# MEILISEARCH_HOST=http://localhost:7700
# MEILISEARCH_API_KEY=your-meilisearch-key

# Qdrant (for vector search)
# QDRANT_HOST=http://localhost:6333
# QDRANT_API_KEY=your-qdrant-key

# Redis (if needed for sessions/caching)
# REDIS_URL=redis://localhost:6379
